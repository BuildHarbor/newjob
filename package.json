{
  "name": "newjob-local",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "A private, free career workspace with local AI",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check server.mjs && node --check public/app.mjs && prettier --check .",
    "format": "prettier --write .",
    "build": "node build.mjs",
    "dev:hosted": "npm run build && netlify dev"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.86",
    "cheerio": "^1.2.0",
    "image-size": "^2.0.4",
    "ipaddr.js": "^2.5.0",
    "mammoth": "^1.10.0",
    "pdfjs-dist": "^6.4.299",
    "pptxgenjs": "^4.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "jszip": "^3.10.2",
    "prettier": "^3.6.2"
  },
  "overrides": {
    "image-size": "$image-size",
    "mammoth": {
      "argparse": "^2.0.1"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BuildHarbor/newjob.git"
  }
}
